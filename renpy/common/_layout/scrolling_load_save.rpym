# Modernized scrollable Load / Save file picker using Ren'Py built-in File* actions
# Note: Standard modern Ren'Py templates define `screen save()` and `screen load()`
# in `screens.rpy`. Rename or merge carefully if your project uses a standard template.

define _load_prompt = True
define config.load_save_slots = 50
define config.load_save_auto_slots = 5
define config.load_save_quick_slots = 5
define config.time_format = "%b %d, %H:%M"
define config.file_entry_format = "%(time)s\n%(save_name)s"
define config.thumbnail_width = 320
define config.thumbnail_height = 240
define config.load_save_empty_thumbnail = None

define gui.file_picker_frame_xmaximum = 0.5
define gui.file_picker_frame_xmargin = 6
define gui.file_picker_frame_ymargin = 6
define gui.file_picker_entry_yminimum = 58
define gui.thumbnail_frame_ymargin = 6
define gui.thumbnail_frame_xpos = 0.75
define gui.thumbnail_frame_xanchor = 0.5

init python:
    def _fp_built_in_slots():
        # Ren'Py's File* actions use 1-based slot numbers on the active page.
        slots = []
        for idx in range(1, config.load_save_slots + 1):
            slots.append((idx, str(idx), False))

        if config.has_quicksave:
            for idx in range(1, config.load_save_quick_slots + 1):
                slots.append((idx, _("q") + str(idx), True))

        if config.has_autosave:
            for idx in range(1, config.load_save_auto_slots + 1):
                slots.append((idx, _("a") + str(idx), True))

        return slots

screen scroll_file_picker_builtin(mode="load"):

    tag menu

    default save_mode = (mode == "save")
    default hovered_slot = None
    default hovered_readonly = False
    default yadj = ui.adjustment()

    $ slot_defs = _fp_built_in_slots()
    $ current_page = FileCurrentPage()

    use game_menu_navigation(current_screen=mode)

    frame:
        style "file_picker_frame"
        xmaximum gui.file_picker_frame_xmaximum
        xmargin gui.file_picker_frame_xmargin
        ymargin gui.file_picker_frame_ymargin
        yfill True

        hbox:
            style "file_picker_side"

            viewport:
                style "file_picker_viewport"
                yadjustment yadj
                mousewheel True

                vbox:
                    style "file_picker_box"

                    for slot_num, slot_label, is_special_page in slot_defs:
                        $ has_file = FileLoadable(slot_num)
                        $ is_newest = FileNewest(slot_num)
                        $ slot_time = FileTime(slot_num, format=config.time_format, empty="")
                        $ slot_name = FileSaveName(slot_num)
                        $ slot_thumb = FileScreenshot(slot_num)
                        $ can_click = (not is_special_page) if save_mode else has_file

                        button:
                            style style.file_picker_entry[slot_num - 1]
                            xfill True
                            yminimum gui.file_picker_entry_yminimum
                            selected is_newest
                            sensitive can_click
                            action (FileAction(slot_num) if can_click else NullAction())
                            hovered [
                                SetScreenVariable("hovered_slot", slot_num),
                                SetScreenVariable("hovered_readonly", is_special_page),
                            ]
                            unhovered If(
                                hovered_slot == slot_num,
                                [
                                    SetScreenVariable("hovered_slot", None),
                                    SetScreenVariable("hovered_readonly", False),
                                ],
                            )
                            if has_file and not is_special_page:
                                key "save_delete" action FileDelete(slot_num)

                            if has_file:
                                $ entry_body = config.file_entry_format % {
                                    "time": slot_time,
                                    "save_name": slot_name,
                                }
                                text (slot_label + ". " + entry_body):
                                    style style.file_picker_text[slot_num - 1]
                            else:
                                text (slot_label + ". " + _("Empty Slot.")):
                                    style style.file_picker_text[slot_num - 1]

            vbar:
                style "file_picker_scrollbar"
                adjustment yadj

    frame:
        style "thumbnail_frame"
        ymargin gui.thumbnail_frame_ymargin
        xpos gui.thumbnail_frame_xpos
        xanchor gui.thumbnail_frame_xanchor

        if hovered_slot is not None and FileLoadable(hovered_slot):
            add FileScreenshot(hovered_slot)
        elif config.load_save_empty_thumbnail:
            add config.load_save_empty_thumbnail
        else:
            add Null(width=config.thumbnail_width, height=config.thumbnail_height)

label save_screen:
    $ renpy.call_screen("scroll_file_picker_builtin", mode="save")
    return

label load_screen:
    $ renpy.call_screen("scroll_file_picker_builtin", mode="load")
    return
