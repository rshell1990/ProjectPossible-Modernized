# Modernized yes/no prompt screen for Ren'Py 7 / 8+
# Note: In standard modern Ren'Py projects, `screen yesno(message, yes_action, no_action)`
# already exists in `screens.rpy`. Rename or merge carefully if your project defines one.

define gui.yesno_frame_xmargin = 0.05
define gui.yesno_frame_ypos = 0.1
define gui.yesno_frame_yanchor = 0.0
define gui.yesno_frame_ypadding = 0.05

define gui.yesno_vbox_spacing = 30
define gui.yesno_button_spacing = 100

screen yesno_prompt(message):

    modal True

    zorder 200

    style_prefix "yesno"

    on "show" action Function(renpy.transition, config.intra_transition)
    on "hide" action Function(renpy.transition, config.intra_transition)

    frame:
        xfill True
        xmargin gui.yesno_frame_xmargin
        ypos gui.yesno_frame_ypos
        yanchor gui.yesno_frame_yanchor
        ypadding gui.yesno_frame_ypadding

        vbox:
            xalign 0.5
            yalign 0.5
            spacing gui.yesno_vbox_spacing

            label _(message):
                style "yesno_prompt_text"
                xalign 0.5

            hbox:
                xalign 0.5
                spacing gui.yesno_button_spacing

                textbutton _("Yes"):
                    style "yesno_button"
                    text_style "yesno_button_text"
                    action Return(True)

                textbutton _("No"):
                    style "yesno_button"
                    text_style "yesno_button_text"
                    action Return(False)
