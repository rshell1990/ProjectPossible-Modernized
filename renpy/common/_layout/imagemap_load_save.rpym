# Modernized Load / Save file picker for Ren'Py 7 / 8+
# Note: Standard modern Ren'Py templates define `screen save()` and `screen load()`
# in `screens.rpy`. Rename or merge carefully if your project uses a standard template.

define config.load_save_ground = {}
define config.load_save_idle = {}
define config.load_save_hover = {}
define config.load_save_selected_idle = {}
define config.load_save_selected_hover = {}
define config.load_save_hotspots = {}

define config.disable_thumbnails = False
define config.load_save_empty_thumbnail = None
define config.time_format = "%b %d, %H:%M"
define config.file_entry_format = "%(time)s\n%(save_name)s"
define _load_prompt = True

init python:
    import time

    class _LoadSaveState(object):
        def __init__(self):
            self.file_picker_page = None
            self.initialized = False
            self.per_page = 0
            self.pages = 0
            self.has_autosave = False
            self.has_quicksave = False

    _ls_state = _LoadSaveState()

    def _ls_resolve_variant(val, variant):
        if isinstance(val, dict):
            return val.get(variant, val.get(None))
        return val

    def _ls_process_screenshot(s):
        return s

    def _ls_init():
        hotspot_names = set()
        raw_hotspots = config.load_save_hotspots

        if isinstance(raw_hotspots, dict):
            for entries in raw_hotspots.values():
                for (_x1, _y1, _x2, _y2, name) in entries:
                    hotspot_names.add(name)
        elif raw_hotspots:
            for (_x1, _y1, _x2, _y2, name) in raw_hotspots:
                hotspot_names.add(name)

        _ls_state.has_autosave = "page_auto" in hotspot_names
        _ls_state.has_quicksave = "page_quick" in hotspot_names

        per_page = 0
        while ("slot_%d" % per_page) in hotspot_names:
            per_page += 1
        _ls_state.per_page = per_page

        pages = 1
        while ("page_%d" % pages) in hotspot_names:
            pages += 1
        _ls_state.pages = max(0, pages - 1)
        _ls_state.initialized = True

    def _ls_page_files(page):
        per_page = _ls_state.per_page
        entries = []

        if _ls_state.has_autosave:
            if page == 0:
                for i in range(1, per_page + 1):
                    entries.append(("auto-" + str(i), _("a") + str(i), True))
                return entries
            page -= 1

        if _ls_state.has_quicksave:
            if page == 0:
                for i in range(1, per_page + 1):
                    entries.append(("quick-" + str(i), _("q") + str(i), True))
                return entries
            page -= 1

        start = per_page * page + 1
        for i in range(start, start + per_page):
            entries.append((str(i), str(i), False))

        return entries

    def _ls_file_page(filename):
        per_page = _ls_state.per_page
        if per_page <= 0:
            return 0

        base = 0
        if _ls_state.has_autosave:
            if filename.startswith("auto-"):
                return base
            base += 1

        if _ls_state.has_quicksave:
            if filename.startswith("quick-"):
                return base
            base += 1

        try:
            return base + ((int(filename) - 1) // per_page)
        except Exception:
            return base

    def _ls_pages():
        pages = []
        if config.has_autosave:
            pages.append("page_auto")
        if config.has_quicksave:
            pages.append("page_quick")
        for i in range(1, _ls_state.pages + 1):
            pages.append("page_%d" % i)
        return pages

    def _ls_format_entry(slot_name, extra_info, mtime):
        formatted_time = time.strftime(config.time_format, time.localtime(mtime))
        body = config.file_entry_format % {
            "time": formatted_time,
            "save_name": extra_info,
        }
        return "%s. %s" % (slot_name, body)

    def _ls_collect_saves():
        saved_games = renpy.list_saved_games(regexp=r"(auto-|quick-)?[0-9]+")
        newest_fn = None
        newest_mtime = None
        save_info = {}

        for fn, extra_info, screenshot, mtime in saved_games:
            thumb = _ls_process_screenshot(screenshot)
            save_info[fn] = (extra_info, thumb, mtime)
            if not fn.startswith("auto-") and (newest_mtime is None or mtime > newest_mtime):
                newest_fn = fn
                newest_mtime = mtime

        return save_info, newest_fn

screen file_picker_screen(mode="load"):
    tag menu

    default save_mode = (mode == "save")
    default page_index = _ls_state.file_picker_page

    $ ground_img = _ls_resolve_variant(config.load_save_ground, mode)
    $ idle_img = _ls_resolve_variant(config.load_save_idle, mode) or ground_img
    $ hover_img = _ls_resolve_variant(config.load_save_hover, mode) or idle_img
    $ sel_idle_img = _ls_resolve_variant(config.load_save_selected_idle, mode) or idle_img
    $ sel_hover_img = _ls_resolve_variant(config.load_save_selected_hover, mode) or hover_img

    $ hotspot_list = list(_ls_resolve_variant(config.load_save_hotspots, mode) or ())
    $ hotspot_map = {name: (x1, y1, x2 - x1, y2 - y1) for x1, y1, x2, y2, name in hotspot_list}

    $ save_info, newest_fn = _ls_collect_saves()

    if page_index is None:
        $ page_index = _ls_file_page(newest_fn) if newest_fn else _ls_file_page("1")
    if page_index < 0:
        $ page_index = 0

    $ _ls_state.file_picker_page = page_index
    $ page_files = _ls_page_files(page_index)
    $ nav_pages = _ls_pages()

    use game_menu_navigation(current_screen=mode)

    imagemap:
        style "imagemap"
        ground ground_img
        idle idle_img
        hover hover_img
        selected_idle sel_idle_img
        selected_hover sel_hover_img

        # Previous page button
        if "previous" in hotspot_map:
            $ px, py, pw, ph = hotspot_map["previous"]
            hotspot:
                style "imagemap_button"
                area (px, py, pw, ph)
                sensitive (page_index > 0)
                action Return(("fppdelta", -1))

        # Page selector buttons (page_auto, page_quick, page_1, ...)
        for idx, page_name in enumerate(nav_pages):
            if page_name in hotspot_map:
                $ qx, qy, qw, qh = hotspot_map[page_name]
                hotspot:
                    style "imagemap_button"
                    area (qx, qy, qw, qh)
                    selected (page_index == idx)
                    action Return(("fppset", idx))

        # Next page button
        if "next" in hotspot_map:
            $ nx, ny, nw, nh = hotspot_map["next"]
            hotspot:
                style "imagemap_button"
                area (nx, ny, nw, nh)
                action Return(("fppdelta", 1))

        # Save / load slots
        for slot_idx, (filename, slot_label, is_readonly) in enumerate(page_files):
            $ slot_key = "slot_%d" % slot_idx
            if slot_key in hotspot_map:
                $ sx, sy, sw, sh = hotspot_map[slot_key]
                $ has_file = filename in save_info
                $ can_click = (not is_readonly) if save_mode else has_file
                $ is_newest = (has_file and newest_fn == filename)

                hotspot:
                    style "imagemap_button"
                    area (sx, sy, sw, sh)
                    selected is_newest
                    sensitive can_click
                    action (Return(("return", filename)) if can_click else NullAction())
                    if has_file and not is_readonly:
                        key "save_delete" action Return(("unlink", filename))

                fixed:
                    pos (sx, sy)
                    xysize (sw, sh)

                    if not config.disable_thumbnails:
                        if has_file:
                            $ _extra, thumb_img, _mtime = save_info[filename]
                            window:
                                style style.file_picker_ss_window[slot_idx]
                                add thumb_img
                        elif config.load_save_empty_thumbnail:
                            window:
                                style style.file_picker_ss_window[slot_idx]
                                add config.load_save_empty_thumbnail

                    window:
                        style style.file_picker_text_window[slot_idx]
                        if has_file:
                            $ extra_info, _thumb, mtime = save_info[filename]
                            text _ls_format_entry(slot_label, extra_info, mtime):
                                style style.file_picker_text[slot_idx]
                        else:
                            text (slot_label + ". " + _("Empty Slot.") + "\n"):
                                style style.file_picker_empty_slot[slot_idx]

label save_screen:
    python:
        if not _ls_state.initialized:
            _ls_init()

        while True:
            result = renpy.call_screen("file_picker_screen", mode="save")
            if not isinstance(result, tuple):
                return

            action_type, value = result

            if action_type == "unlink":
                if renpy.call_screen("yesno_prompt", message=layout.DELETE_SAVE):
                    renpy.unlink_save(value)
                continue

            if action_type == "fppdelta":
                _ls_state.file_picker_page = max(0, (_ls_state.file_picker_page or 0) + value)
                continue

            if action_type == "fppset":
                _ls_state.file_picker_page = value
                continue

            if action_type == "return":
                fn = value
                if renpy.can_load(fn):
                    if not renpy.call_screen("yesno_prompt", message=layout.OVERWRITE_SAVE):
                        continue
                renpy.save(fn, extra_info=store.save_name)
                return

label load_screen:
    python:
        if not _ls_state.initialized:
            _ls_init()

        while True:
            result = renpy.call_screen("file_picker_screen", mode="load")
            if not isinstance(result, tuple):
                return

            action_type, value = result

            if action_type == "unlink":
                if renpy.call_screen("yesno_prompt", message=layout.DELETE_SAVE):
                    renpy.unlink_save(value)
                continue

            if action_type == "fppdelta":
                _ls_state.file_picker_page = max(0, (_ls_state.file_picker_page or 0) + value)
                continue

            if action_type == "fppset":
                _ls_state.file_picker_page = value
                continue

            if action_type == "return":
                fn = value
                if _load_prompt:
                    if not renpy.call_screen("yesno_prompt", message=layout.LOADING):
                        continue
                renpy.load(fn)
