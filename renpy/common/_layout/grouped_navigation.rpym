# Modernized game menu navigation screen for Ren'Py 7 / 8+
# Note: Standard modern Ren'Py templates define `screen navigation()` in `screens.rpy`.
# Rename or merge carefully if your project uses a standard template.

define gui.gm_nav_frame_xalign = 0.5
define gui.gm_nav_frame_ypos = 0.98
define gui.gm_nav_frame_yanchor = 1.0
define gui.gm_nav_inner_box_xalign = 0.5
define config.navigation_per_group = 4

init python:
    def _gm_nav_eval(expr, default=True):
        if expr is None:
            return default
        if isinstance(expr, bool):
            return expr
        if isinstance(expr, basestring):
            return bool(renpy.python.py_eval(expr))
        return bool(expr)

    def _gm_nav_root_style(screen_name):
        # Supports style.gm_root[screen_name] if present, with safe fallback.
        try:
            root_style = style.gm_root[screen_name]
            return root_style.name if hasattr(root_style, "name") else root_style
        except Exception:
            return "gm_root"

screen game_menu_navigation(current_screen=None):

    tag menu

    style_prefix "gm_nav"

    # Game menu backdrop (uses gm_root[current_screen] when available)
    window:
        style _gm_nav_root_style(current_screen)
        null

    if current_screen is not None:
        frame:
            style "gm_nav_frame"
            xalign gui.gm_nav_frame_xalign
            ypos gui.gm_nav_frame_ypos
            yanchor gui.gm_nav_frame_yanchor

            vbox:
                id "gm_nav"
                style "gm_nav_outer_box"

                $ visible_entries = []
                for entry in config.game_menu:
                    if len(entry) == 4:
                        $ nav_key, nav_label, nav_clicked, nav_enabled = entry
                        $ nav_shown = True
                    else:
                        $ nav_key, nav_label, nav_clicked, nav_enabled, nav_shown = entry

                    if _gm_nav_eval(nav_shown, True):
                        $ visible_entries.append((nav_key, nav_label, nav_clicked, nav_enabled))

                for group_start in range(0, len(visible_entries), config.navigation_per_group):
                    hbox:
                        style "gm_nav_inner_box"
                        xalign gui.gm_nav_inner_box_xalign

                        for nav_key, nav_label, nav_clicked, nav_enabled in visible_entries[group_start:group_start + config.navigation_per_group]:
                            $ is_selected = (current_screen == nav_key)
                            $ is_enabled = _gm_nav_eval(nav_enabled, True)

                            textbutton _(nav_label):
                                style "gm_nav_button"
                                text_style "gm_nav_button_text"
                                selected is_selected
                                sensitive is_enabled
                                action nav_clicked
