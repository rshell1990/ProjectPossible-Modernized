# Modernized imagemap main menu for Ren'Py 7 / 8+
# Note: Standard modern Ren'Py templates define `screen main_menu()` in `screens.rpy`.
# Rename or merge carefully if your project uses a standard template.

define config.main_menu_ground = {}
define config.main_menu_idle = {}
define config.main_menu_selected = {}
define config.main_menu_hotspots = {}
define _main_menu_variant = None

init python:
    def _mm_img_resolve_variant(val, variant):
        if isinstance(val, dict):
            return val.get(variant, val.get(None))
        return val

    def _mm_img_eval_bool(expr, default=True):
        if isinstance(expr, bool):
            return expr
        if isinstance(expr, basestring):
            return bool(renpy.python.py_eval(expr))
        return bool(expr) if expr is not None else default

    def _mm_img_action(clicked, enabled=True):
        if not enabled or clicked is None:
            return None
        if isinstance(clicked, basestring):
            return Start(clicked) if clicked == "start" else renpy.curried_call_in_new_context(clicked)
        return clicked

    def _mm_img_build_hotspot_actions(hotspots, main_menu_entries):
        # Maps hotspot_name -> (action, sensitive)
        actions = {}
        matched_names = set()

        for entry in main_menu_entries:
            if len(entry) == 4:
                name, act, enabled, shown = entry
            else:
                name, act, enabled = entry
                shown = True

            is_shown = _mm_img_eval_bool(shown, True)
            is_enabled = _mm_img_eval_bool(enabled, True)

            if not is_shown:
                matched_names.add(name)
                continue

            matched_names.add(name)
            actions[name] = (_mm_img_action(act, is_enabled), is_enabled)

        # Any remaining hotspot names jump out of context to a label of that name.
        for x1, y1, x2, y2, hs_name in hotspots:
            if hs_name not in matched_names and hs_name not in actions:
                actions[hs_name] = (_mm_img_action(hs_name, True), True)

        return actions

screen imagemap_main_menu():

    tag menu

    style_prefix "mm"

    # Ignore right-click / game_menu key while on the main menu
    key "game_menu" action NullAction()

    $ ground_img = _mm_img_resolve_variant(config.main_menu_ground, _main_menu_variant)
    $ idle_img = _mm_img_resolve_variant(config.main_menu_idle, _main_menu_variant) or ground_img
    $ sel_img = _mm_img_resolve_variant(config.main_menu_selected, _main_menu_variant) or idle_img

    $ hotspot_list = list(_mm_img_resolve_variant(config.main_menu_hotspots, _main_menu_variant) or ())
    $ hs_actions = _mm_img_build_hotspot_actions(hotspot_list, config.main_menu)

    window:
        style "mm_root"
        null

    imagemap:
        style "imagemap"
        ground ground_img
        idle idle_img
        hover sel_img
        selected_idle idle_img
        selected_hover sel_img

        for x1, y1, x2, y2, hs_name in hotspot_list:
            $ w = x2 - x1
            $ h = y2 - y1
            $ action_cfg = hs_actions.get(hs_name)

            hotspot:
                style "imagemap_button"
                area (x1, y1, w, h)
                if action_cfg is not None and action_cfg[0] is not None:
                    sensitive action_cfg[1]
                    action action_cfg[0]
                else:
                    sensitive False
                    action NullAction()

label main_menu_screen:
    $ renpy.scene("master")
    $ renpy.show_screen("imagemap_main_menu")
    $ ui.interact(mouse="mainmenu")
    jump main_menu_screen
