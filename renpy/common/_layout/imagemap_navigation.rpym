# Modernized imagemap navigation for Ren'Py 7 / 8+
# Note: Standard modern Ren'Py templates define `screen navigation()` in `screens.rpy`.
# Rename or merge carefully if your project uses a standard template.

define config.navigation_ground = None
define config.navigation_idle = None
define config.navigation_hover = None
define config.navigation_selected_idle = None
define config.navigation_selected_hover = None
define config.navigation_hotspots = None

init python:
    def _img_nav_eval_bool(expr, default=True):
        if isinstance(expr, bool):
            return expr
        if isinstance(expr, basestring):
            return bool(renpy.python.py_eval(expr))
        return bool(expr) if expr is not None else default

    def _img_nav_root_style(screen_name):
        try:
            root_style = style.gm_root[screen_name]
            return root_style.name if hasattr(root_style, "name") else root_style
        except Exception:
            return "gm_root"

    def _img_nav_build_items(current_screen):
        if current_screen is None:
            return []

        gm = {}
        for entry in config.game_menu:
            screen_name = entry[0]
            btn_name = entry[1]
            act = entry[2]
            enable = entry[3] if len(entry) > 3 else True
            gm[btn_name] = (screen_name, act, enable)

        items = []
        for (x0, y0, x1, y1, name) in (config.navigation_hotspots or ()):
            if name not in gm:
                raise Exception("%r was used in a game menu hotspot, but isn't the name of a game menu button." % name)

            screen_name, act, enable = gm[name]
            if not _img_nav_eval_bool(enable, True):
                continue

            items.append({
                "name": name,
                "area": (x0, y0, x1 - x0, y1 - y0),
                "selected": (screen_name == current_screen),
                "action": act,
            })

        return items

screen imagemap_navigation(current_screen=None):

    tag menu

    $ nav_items = _img_nav_build_items(current_screen)

    window:
        style _img_nav_root_style(current_screen)
        null

    if current_screen is not None:
        imagemap:
            style "imagemap"
            ground config.navigation_ground
            idle config.navigation_idle
            hover config.navigation_hover
            selected_idle config.navigation_selected_idle
            selected_hover config.navigation_selected_hover

            for item in nav_items:
                hotspot:
                    style "imagemap_button"
                    area item["area"]
                    selected item["selected"]
                    action item["action"]
