init python hide:

    layout.provides('yesno_prompt')

    def yesno_prompt(screen, message, **kwargs):

        if config.confirm_screen and renpy.has_screen('confirm'):
            screen = "confirm"
        else:
            screen = "yesno_prompt"

        screen_kwargs = dict(kwargs)
        screen_kwargs.update(
            message=message,
            yes_action=Return(True),
            no_action=Return(False))
        screen_kwargs.setdefault("_mode", "gamemenu")

        return renpy.call_screen(screen, **screen_kwargs)

    layout.yesno_prompt = yesno_prompt
