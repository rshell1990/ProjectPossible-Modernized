init python:

    class _ImageMapper(object):

        def __init__(self, screen, ground, idle, hover, selected_idle, selected_hover, hotspots, navigation=True, variant=None):

            # If the argument is a dict, look up the screen in that dict, and
            # return the result. Otherwise, just return the result.
            def maybe_variant(a):
                if isinstance(a, dict):
                    if variant in a:
                        return a[variant]
                    else:
                        return a[None]
                return a

            ground = maybe_variant(ground)

            self.idle = maybe_variant(idle) or ground
            self.hover = maybe_variant(hover) or self.idle
            self.selected_idle = maybe_variant(selected_idle) or self.idle
            self.selected_hover = maybe_variant(selected_hover) or self.hover

            self.hotspots = { }
            for (x1, y1, x2, y2, name) in maybe_variant(hotspots):
                self.hotspots[name] = (x1, y1, x2, y2)

            self.remaining_hotspots = set(self.hotspots.keys())
            self.screen = screen
            self.ground = ground
            self.buttons = [ ]
            self.bars = [ ]
            self.overlays = [ ]
            self.navigation = False

            if navigation:

                # Display the layout navigation only if there are no
                # game menu buttons defined.
                for i in config.game_menu:
                    if i[1] in self.hotspots:
                        break
                else:
                    self.navigation = True

                # Display any navigation buttons that exist.
                for e in config.game_menu:
                    screen_ = e[0]
                    name = e[1]
                    act = e[2]
                    enable = e[3]

                    if not eval(enable):
                        continue

                    self.button(name, act, screen == screen_)

        def button(self, name, clicked, selected, keymap={}):

            if name not in self.hotspots:
                return None

            self.remaining_hotspots.discard(name)

            x1, y1, x2, y2 = self.hotspots[name]

            if clicked is None:
                return (x1, y1, x2, y2)

            if selected:
                idle = self.selected_idle
                hover = self.selected_hover
            else:
                idle = self.idle
                hover = self.hover

            self.buttons.append({
                "idle": LiveCrop((x1, y1, (x2 - x1), (y2 - y1)), idle),
                "hover": LiveCrop((x1, y1, (x2 - x1), (y2 - y1)), hover),
                "x": x1,
                "y": y1,
                "action": clicked,
                "keymap": keymap,
                })

            return (x1, y1, x2, y2)


        def bar(self, name, range, value, changed):

            if name not in self.hotspots:
                return

            self.remaining_hotspots.discard(name)

            x1, y1, x2, y2 = self.hotspots[name]

            self.bars.append({
                "range": range,
                "value": value,
                "changed": changed,
                "left_bar": LiveCrop((x1, y1, (x2 - x1), (y2 - y1)), self.selected_idle),
                "right_bar": LiveCrop((x1, y1, (x2 - x1), (y2 - y1)), self.idle),
                "hover_left_bar": LiveCrop((x1, y1, (x2 - x1), (y2 - y1)), self.selected_hover),
                "hover_right_bar": LiveCrop((x1, y1, (x2 - x1), (y2 - y1)), self.hover),
                "x": x1,
                "y": y1,
                "width": x2 - x1,
                "height": y2 - y1,
                })

        def nothing(self, name):
            self.remaining_hotspots.discard(name)

        def close(self):
            pass

        def overlay(self, rect, kind, **kwargs):
            kwargs.update(rect=rect, kind=kind)
            self.overlays.append(kwargs)


screen _imagemap_fixed(ime):

    fixed:
        style "imagemap"

        add ime.ground

        for item in ime.buttons:
            button:
                style "imagemap_button"
                action item["action"]
                background item["idle"]
                hover_background item["hover"]
                insensitive_background item["idle"]
                focus_mask True
                xpos item["x"]
                ypos item["y"]
                xanchor 0
                yanchor 0

                for key_name, key_action in item["keymap"].items():
                    key key_name action key_action

        for item in ime.bars:
            bar:
                range item["range"]
                value item["value"]
                changed item["changed"]
                left_gutter 0
                right_gutter 0
                left_bar item["left_bar"]
                right_bar item["right_bar"]
                hover_left_bar item["hover_left_bar"]
                hover_right_bar item["hover_right_bar"]
                bar_resizing False
                xpos item["x"]
                ypos item["y"]
                xmaximum item["width"]
                ymaximum item["height"]
                thumb None
                thumb_shadow None
                thumb_offset 0

        for item in ime.overlays:
            fixed:
                xpos item["rect"][0]
                ypos item["rect"][1]
                xmaximum item["rect"][2] - item["rect"][0]
                ymaximum item["rect"][3] - item["rect"][1]

                if item["kind"] == "save":
                    if item["thumbnail"] is not None:
                        window:
                            style style.file_picker_ss_window[item["index"]]
                            add item["thumbnail"]

                    window:
                        style style.file_picker_text_window[item["index"]]
                        text item["text"]:
                            style style.file_picker_text[item["index"]]

                elif item["kind"] == "empty":
                    if item["thumbnail"] is not None:
                        window:
                            style style.file_picker_ss_window[item["index"]]
                            add item["thumbnail"]

                    window:
                        style style.file_picker_text_window[item["index"]]
                        text item["text"]:
                            style style.file_picker_empty_slot[item["index"]]
