# Clean modern imagemap screen for Ren'Py 7 / 8+

init python:
    def _mm_resolve_variant(val, variant):
        if isinstance(val, dict):
            return val.get(variant, val.get(None))
        return val

    def _mm_eval_bool(expr, default=True):
        if isinstance(expr, bool):
            return expr
        if isinstance(expr, basestring):
            return bool(renpy.python.py_eval(expr))
        return bool(expr) if expr is not None else default

    def _mm_normalize_buttons(buttons):
        # Returns {name: (action, selected, sensitive)}
        result = {}
        if isinstance(buttons, dict):
            for name, action in buttons.items():
                if action is not None:
                    result[name] = (action, False, True)
        elif buttons:
            for item in buttons:
                name = item[0]
                action = item[1]
                selected = item[2] if len(item) > 2 else False
                sensitive = item[3] if len(item) > 3 else True
                if action is not None:
                    result[name] = (action, selected, sensitive)
        return result

screen mapped_menu(
    current_screen=None,
    ground=None,
    idle=None,
    hover=None,
    selected_idle=None,
    selected_hover=None,
    hotspots=(),
    buttons=None,
    bars=None,
    use_navigation=True,
    variant=None,
):
    $ ground_img = _mm_resolve_variant(ground, variant)
    $ idle_img = _mm_resolve_variant(idle, variant) or ground_img
    $ hover_img = _mm_resolve_variant(hover, variant) or idle_img
    $ sel_idle_img = _mm_resolve_variant(selected_idle, variant) or idle_img
    $ sel_hover_img = _mm_resolve_variant(selected_hover, variant) or hover_img

    $ hotspot_list = list(_mm_resolve_variant(hotspots, variant) or ())
    $ hotspot_rects = {name: (x1, y1, x2 - x1, y2 - y1) for x1, y1, x2, y2, name in hotspot_list}

    # Collect actions by hotspot name so each hotspot renders once
    $ hotspot_actions = {}

    if use_navigation:
        for entry in config.game_menu:
            $ nav_screen = entry[0]
            $ nav_name = entry[1]
            $ nav_action = entry[2]
            $ nav_enabled = entry[3] if len(entry) > 3 else True

            if nav_name in hotspot_rects and _mm_eval_bool(nav_enabled, True):
                $ hotspot_actions[nav_name] = (nav_action, current_screen == nav_screen, True)

    $ custom_buttons = _mm_normalize_buttons(buttons)
    for btn_name, btn_cfg in custom_buttons.items():
        if btn_name in hotspot_rects:
            $ hotspot_actions[btn_name] = btn_cfg

    $ has_menu_hotspot = any(entry[1] in hotspot_rects for entry in config.game_menu)
    if use_navigation and not has_menu_hotspot:
        use game_menu_navigation(current_screen=current_screen)

    imagemap:
        style "imagemap"
        ground ground_img
        idle idle_img
        hover hover_img
        selected_idle sel_idle_img
        selected_hover sel_hover_img

        for x1, y1, x2, y2, hs_name in hotspot_list:
            $ w = x2 - x1
            $ h = y2 - y1
            $ cfg = hotspot_actions.get(hs_name)

            hotspot:
                style "imagemap_button"
                area (x1, y1, w, h)
                if cfg is not None:
                    selected cfg[1]
                    sensitive cfg[2]
                    action cfg[0]
                else:
                    action NullAction()

        if bars:
            for b in bars:
                $ b_name = b["name"] if isinstance(b, dict) else b[0]
                $ b_range = b["range"] if isinstance(b, dict) else b[1]
                $ b_value = b["value"] if isinstance(b, dict) else b[2]
                $ b_changed = b["changed"] if isinstance(b, dict) else b[3]

                if b_name in hotspot_rects:
                    $ bx, by, bw, bh = hotspot_rects[b_name]
                    bar:
                        pos (bx, by)
                        xysize (bw, bh)
                        range b_range
                        value b_value
                        changed b_changed
                        left_gutter 0
                        right_gutter 0
                        thumb None
                        thumb_shadow None
                        thumb_offset 0
                        left_bar Crop((bx, by, bw, bh), sel_idle_img)
                        right_bar Crop((bx, by, bw, bh), idle_img)
                        hover_left_bar Crop((bx, by, bw, bh), sel_hover_img)
                        hover_right_bar Crop((bx, by, bw, bh), hover_img)
