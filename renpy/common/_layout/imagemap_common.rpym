init python:

    class _ImageMapper(object):

        def __init__(self, screen, ground, idle, hover, selected_idle, selected_hover, hotspots, navigation=True, variant=None):

            # If the argument is a dict, look up the screen in that dict, and
            # return the result. Otherwise, just return the result.
            def maybe_variant(a):
                if isinstance(a, dict):
                    if variant in a:
                        return a[variant]
                    else:
                        return a[None]
                return a

            ground = maybe_variant(ground)

            self.screen = screen
            self.ground = ground
            self.idle = maybe_variant(idle) or ground
            self.hover = maybe_variant(hover) or self.idle
            self.selected_idle = maybe_variant(selected_idle) or self.idle
            self.selected_hover = maybe_variant(selected_hover) or self.hover

            self.hotspots = { }
            for (x1, y1, x2, y2, name) in maybe_variant(hotspots):
                self.hotspots[name] = (x1, y1, x2, y2)

            self.remaining_hotspots = set(self.hotspots.keys())
            self.items = [ ]
            self.show_default_nav = False

            if navigation:

                # Display the layout navigation only if there are no
                # game menu buttons defined.
                for i in config.game_menu:
                    if i[1] in self.hotspots:
                        break
                else:
                    self.show_default_nav = True

            if navigation:

                # Display any navigation buttons that exist.
                for e in config.game_menu:
                    screen_ = e[0]
                    name = e[1]
                    act = e[2]
                    enable = e[3]

                    if not eval(enable):
                        continue

                    self.button(name, act, screen == screen_)

        def button(self, name, clicked, selected, keymap={}):

            if name not in self.hotspots:
                return None

            self.remaining_hotspots.discard(name)

            x1, y1, x2, y2 = self.hotspots[name]

            if clicked is None:
                return (x1, y1, x2, y2)

            if selected:
                idle = self.selected_idle
                hover = self.selected_hover
            else:
                idle = self.idle
                hover = self.hover

            self.items.append(("button", {
                "rect" : (x1, y1, (x2 - x1), (y2 - y1)),
                "idle" : idle,
                "hover" : hover,
                "xpos" : x1,
                "ypos" : y1,
                "clicked" : clicked,
                "keymap" : dict(keymap) if keymap else None,
                }))

            return (x1, y1, x2, y2)


        def bar(self, name, range, value, changed):

            if name not in self.hotspots:
                return

            self.remaining_hotspots.discard(name)

            x1, y1, x2, y2 = self.hotspots[name]

            self.items.append(("bar", {
                "range" : range,
                "value" : value,
                "changed" : changed,
                "rect" : (x1, y1, (x2 - x1), (y2 - y1)),
                "xpos" : x1,
                "ypos" : y1,
                "xmaximum" : (x2 - x1),
                "ymaximum" : (y2 - y1),
                }))

        def nothing(self, name):
            self.remaining_hotspots.discard(name)

        def close(self):
            pass

screen _imagemap_contents(ime, use_sl2_nav=False):

    default hovered_keymap = None

    if ime.show_default_nav and use_sl2_nav:
        use _layout_navigation(ime.screen)

    fixed style "imagemap":
        add ime.ground

        for kind, data in ime.items:
            if kind == "button":
                imagebutton:
                    idle Crop(data["rect"], data["idle"])
                    hover Crop(data["rect"], data["hover"])
                    xpos data["xpos"]
                    ypos data["ypos"]
                    xanchor 0
                    yanchor 0
                    action data["clicked"]
                    focus_mask True
                    style "imagemap_button"
                    if data["keymap"]:
                        hovered SetScreenVariable("hovered_keymap", data["keymap"])
                        unhovered SetScreenVariable("hovered_keymap", None)
            elif kind == "bar":
                bar:
                    range data["range"]
                    value data["value"]
                    changed data["changed"]
                    left_gutter 0
                    right_gutter 0
                    left_bar Crop(data["rect"], ime.selected_idle)
                    right_bar Crop(data["rect"], ime.idle)
                    hover_left_bar Crop(data["rect"], ime.selected_hover)
                    hover_right_bar Crop(data["rect"], ime.hover)
                    bar_resizing False
                    xpos data["xpos"]
                    ypos data["ypos"]
                    xmaximum data["xmaximum"]
                    ymaximum data["ymaximum"]
                    thumb None
                    thumb_shadow None
                    thumb_offset 0

    if hovered_keymap:
        for k, act in hovered_keymap.items():
            key k action act
