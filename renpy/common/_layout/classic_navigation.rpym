init python:
    # Preserve legacy style names and positioning properties
    style.gm_nav_frame = Style(style.frame, help="game menu navigation frame")
    style.gm_nav_box = Style(style.vbox, help="box containing game menu navigation buttons")

    style.gm_nav_button = Style(style.button, help="game menu navigation button")
    style.gm_nav_button_text = Style(style.button_text, help="game menu navigation button (text)")

    style.gm_nav_button.size_group = "gm_nav_button"

    style.gm_nav_frame.xpos = 5.0 / 6.0
    style.gm_nav_frame.xanchor = 0.5
    style.gm_nav_frame.ypos = 0.95
    style.gm_nav_frame.yanchor = 1.0

    def _eval_nav_cond(cond, default=False):
        if cond is None:
            return default

        if callable(cond):
            return bool(cond())

        if isinstance(cond, basestring):
            try:
                return bool(renpy.python.py_eval(cond))
            except Exception:
                return default

        return bool(cond)

screen navigation(current_screen=None):
    # Game menu background root container
    window:
        style style.gm_root[current_screen]
        null

    if current_screen is not None:
        frame:
            style "gm_nav_frame"

            vbox:
                id "gm_nav"
                style "gm_nav_box"

                for entry in config.game_menu:
                    if len(entry) == 4:
                        $ key, label, clicked, enabled = entry
                        $ shown = True
                    else:
                        $ key, label, clicked, enabled, shown = entry

                    if _eval_nav_cond(shown, True):
                        textbutton _(label):
                            style "gm_nav_button"
                            text_style "gm_nav_button_text"
                            selected (current_screen == key)
                            sensitive _eval_nav_cond(enabled, True)
                            action clicked
