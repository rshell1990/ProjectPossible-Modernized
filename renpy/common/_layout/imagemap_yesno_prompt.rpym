# Modernized imagemap yes/no prompt with standard yesno(message, yes_action, no_action) signature

define config.yesno_prompt_ground = None
define config.yesno_prompt_idle = None
define config.yesno_prompt_hover = None
define config.yesno_prompt_hotspots = None
define config.yesno_prompt_message_images = {}

init python:
    def _yn_img_resolve_message_image(message):
        default_img = config.yesno_prompt_message_images.get(layout.ARE_YOU_SURE, None)
        return config.yesno_prompt_message_images.get(message, default_img)

screen yesno(message, yes_action, no_action):

    modal True

    zorder 200

    on "show" action Function(renpy.transition, config.intra_transition)
    on "hide" action Function(renpy.transition, config.intra_transition)

    $ hotspot_list = list(config.yesno_prompt_hotspots or ())
    $ hotspot_map = {name: (x1, y1, x2 - x1, y2 - y1) for x1, y1, x2, y2, name in hotspot_list}
    $ msg_image = _yn_img_resolve_message_image(message)

    imagemap:
        style "imagemap"
        ground config.yesno_prompt_ground
        idle config.yesno_prompt_idle
        hover config.yesno_prompt_hover
        selected_idle config.yesno_prompt_idle
        selected_hover config.yesno_prompt_hover

        if "Yes" in hotspot_map:
            $ yx, yy, yw, yh = hotspot_map["Yes"]
            hotspot:
                style "imagemap_button"
                area (yx, yy, yw, yh)
                action yes_action

        if "No" in hotspot_map:
            $ nx, ny, nw, nh = hotspot_map["No"]
            hotspot:
                style "imagemap_button"
                area (nx, ny, nw, nh)
                action no_action

    if msg_image:
        add msg_image
    else:
        label _(message):
            style "yesno_prompt"
            text_style "yesno_prompt_text"
