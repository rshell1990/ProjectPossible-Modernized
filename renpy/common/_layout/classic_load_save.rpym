
init python:

    layout.provides("load_save")

    style.file_picker_entry = Style(style.large_button, help="used to select a file to load or save")
    style.file_picker_entry_box = Style(style.hbox, help="the box inside a file picker entry")
    style.file_picker_text = Style(style.large_button_text, help="text inside a file picker entry")
    style.file_picker_empty_slot = Style(style.file_picker_text, help="text inside an empty file picker entry slot")
    style.file_picker_extra_info = Style(style.file_picker_text)
    style.file_picker_new = Style(style.file_picker_text)
    style.file_picker_old = Style(style.file_picker_text)

    style.file_picker_frame = Style(style.menu_frame, help="the frame enclosing the entire file picker")
    style.file_picker_frame_box = Style(style.vbox, help="the box containing the navigation and file entries")
    style.file_picker_navbox = Style(style.hbox, help="the box containing navigation buttons")
    style.file_picker_nav_button = Style(style.small_button, help="a file picker navigation button")
    style.file_picker_nav_button_text = Style(style.small_button_text, help="file picker navigation button text")
    style.file_picker_grid = Style(style.default, help="a grid containing file picker entries")

    style.file_picker_entry.xminimum = 0.5
    style.file_picker_frame.xmargin = 6
    style.file_picker_frame.ymargin = 6
    style.file_picker_frame_box.box_spacing = 4
    style.file_picker_entry_box.box_spacing = 4

    config.file_page_cols = 2
    config.file_page_rows = 4 if config.screen_width <= 640 else 5
    config.file_quick_access_pages = 6 if config.screen_width <= 640 else 8
    config.disable_file_pager = False
    config.disable_thumbnails = False
    config.load_save_empty_thumbnail = None
    config.thumbnail_width = 320
    config.thumbnail_height = 240
    config.time_format = "%b %d, %H:%M"
    config.file_entry_format = "%(time)s\n%(save_name)s"

    _load_prompt = True


screen classic_file_picker(mode="load"):
    tag menu
    modal True

    $ save_mode = (mode == "save")
    $ page_size = config.file_page_cols * config.file_page_rows
    $ page = FileCurrentPage()

    use game_menu_navigation(current_screen=mode)

    frame:
        style "file_picker_frame"

        vbox:
            style "file_picker_frame_box"

            if not config.disable_file_pager:
                hbox:
                    style "file_picker_navbox"

                    textbutton _("Previous"):
                        style "file_picker_nav_button"
                        action FilePagePrevious()

                    textbutton _("Next"):
                        style "file_picker_nav_button"
                        action FilePageNext()

            grid config.file_page_cols config.file_page_rows:
                style "file_picker_grid"
                transpose True

                for index in range(page * page_size + 1, (page + 1) * page_size + 1):
                    $ slot_name = str(index)
                    $ has_file = FileLoadable(index)
                    $ is_newest = FileNewest(index)
                    $ slot_time = FileTime(index, format=config.time_format, empty="")
                    $ slot_extra = FileSaveName(index)
                    $ screenshot = FileScreenshot(index)

                    button:
                        style style.file_picker_entry[index - 1]
                        xfill True
                        selected is_newest
                        sensitive (save_mode or has_file)
                        action (FileSave(index) if save_mode else FileLoad(index))

                        if has_file:
                            key "save_delete" action FileDelete(index)

                        hbox:
                            style style.file_picker_entry_box[index - 1]

                            if not config.disable_thumbnails:
                                if has_file and screenshot:
                                    add screenshot
                                elif config.load_save_empty_thumbnail:
                                    add config.load_save_empty_thumbnail
                                else:
                                    add Null(width=config.thumbnail_width, height=config.thumbnail_height)

                            vbox:
                                if has_file:
                                    text (slot_name + ". " + (config.file_entry_format % {
                                        "time": slot_time,
                                        "save_name": slot_extra,
                                    })):
                                        style style.file_picker_text[index - 1]
                                else:
                                    text (slot_name + ". " + _("Empty Slot.")):
                                        style style.file_picker_empty_slot[index - 1]


label save_screen:
    $ renpy.call_screen("classic_file_picker", mode="save")
    return


label load_screen:
    $ renpy.call_screen("classic_file_picker", mode="load")
    return
