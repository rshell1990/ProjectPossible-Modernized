screen preferences():
    tag menu

    use game_menu(_("Preferences"), scroll="viewport"):
        frame:
            style "prefs_frame"

            hbox:
                style "prefs_frame_box"
                spacing 24

                for col_style, prefs in config.preferences.items():
                    vbox:
                        style col_style
                        spacing 12

                        for pref in prefs:
                            if pref.visible():
                                if isinstance(pref, _ChoicePreference):
                                    frame:
                                        style style.prefs_pref_frame[pref.name]
                                        vbox:
                                            style style.prefs_pref_box[pref.name]
                                            label _(pref.name):
                                                style "prefs_label"
                                                text_style "prefs_label_text"
                                            hbox:
                                                style style.prefs_pref_choicebox[pref.name]
                                                for label, val in pref.choices():
                                                    textbutton _(label):
                                                        style "prefs_button"
                                                        text_style "prefs_button_text"
                                                        selected (getattr(pref.base, pref.field) == val)
                                                        action SetField(pref.base, pref.field, val)

                                elif isinstance(pref, _SliderPreference):
                                    frame:
                                        style style.prefs_pref_frame[pref.name]
                                        vbox:
                                            style style.prefs_pref_box[pref.name]
                                            label _(pref.name):
                                                style "prefs_label"
                                                text_style "prefs_label_text"
                                            bar:
                                                style style.prefs_slider[pref.name]
                                                range pref.range_max
                                                value FieldValue(pref.base, pref.field, pref.range_max)

                                elif isinstance(pref, _VolumePreference):
                                    frame:
                                        style style.prefs_pref_frame[pref.name]
                                        vbox:
                                            style style.prefs_pref_box[pref.name]
                                            label _(pref.name):
                                                style "prefs_label"
                                                text_style "prefs_label_text"
                                            vbox:
                                                style style.prefs_volume_box[pref.name]
                                                $ sample = _resolve(pref.sound)
                                                if sample and config.soundtest_before_volume:
                                                    textbutton _("Test"):
                                                        style "soundtest_button"
                                                        text_style "soundtest_button_text"
                                                        action Play(pref.channel, sample)

                                                bar:
                                                    style style.prefs_volume_slider[pref.name]
                                                    value Preference(pref.mixer + " volume")

                                                if sample and not config.soundtest_before_volume:
                                                    textbutton _("Test"):
                                                        style "soundtest_button"
                                                        text_style "soundtest_button_text"
                                                        action Play(pref.channel, sample)

                                elif isinstance(pref, _JumpPreference):
                                    frame:
                                        style style.prefs_jump[pref.name]
                                        textbutton _(pref.name):
                                            style "prefs_jump_button"
                                            text_style "prefs_jump_button_text"
                                            sensitive pref.enabled()
                                            action ShowMenu(pref.target)
