# Modernized main menu screen for Ren'Py 7 / 8+
# Note: Standard modern Ren'Py templates define `screen main_menu()` in `screens.rpy`.
# Rename this screen/label or merge carefully if you use a standard template.

define gui.mm_frame_xalign = 0.5
define gui.mm_frame_yalign = 0.98
define gui.mm_inner_box_xalign = 0.5
define config.main_menu_per_group = 2

init python:
    def _mm_eval(expr, default=True):
        if expr is None:
            return default
        if isinstance(expr, bool):
            return expr
        if isinstance(expr, basestring):
            return bool(renpy.python.py_eval(expr))
        return bool(expr)

    def _mm_action(clicked):
        # String targets in legacy config.main_menu jump out of context to a label.
        if isinstance(clicked, basestring):
            return Start(clicked) if clicked == "start" else renpy.curried_call_in_new_context(clicked)
        return clicked

screen main_menu_screen():

    tag menu

    style_prefix "mm"

    # Main menu background (inherits/uses mm_root style if defined)
    window:
        style "mm_root"
        null

    frame:
        style "mm_menu_frame"
        xalign gui.mm_frame_xalign
        yalign gui.mm_frame_yalign

        vbox:
            style "mm_outer_box"

            $ visible_entries = []
            for entry in config.main_menu:
                if len(entry) == 3:
                    $ btn_label, btn_clicked, btn_enabled = entry
                    $ btn_shown = True
                else:
                    $ btn_label, btn_clicked, btn_enabled, btn_shown = entry

                if _mm_eval(btn_shown, True):
                    $ visible_entries.append((btn_label, btn_clicked, btn_enabled))

            for group_start in range(0, len(visible_entries), config.main_menu_per_group):
                hbox:
                    style "mm_inner_box"
                    xalign gui.mm_inner_box_xalign

                    for btn_label, btn_clicked, btn_enabled in visible_entries[group_start:group_start + config.main_menu_per_group]:
                        $ is_enabled = _mm_eval(btn_enabled, True)
                        $ action = _mm_action(btn_clicked)

                        textbutton _(btn_label):
                            style "mm_button"
                            text_style "mm_button_text"
                            sensitive is_enabled
                            action action

label main_menu_screen:
    $ renpy.scene("master")
    $ renpy.show_screen("main_menu_screen")
    $ ui.interact(mouse="mainmenu")
    return
